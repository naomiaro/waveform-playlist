{
  "name": "@waveform-playlist/ui-components",
  "version": "5.0.0-alpha.0",
  "description": "React UI components for waveform-playlist",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["waveform", "audio", "react", "components"],
  "author": "Naomi Aro",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0",
    "styled-components": ">=5.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@types/styled-components": "^5.1.26",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "styled-components": "^6.1.8",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@waveform-playlist/core": "workspace:*",
    "@waveform-playlist/state": "workspace:*",
    "@waveform-playlist/playout": "workspace:*",
    "@waveform-playlist/loaders": "workspace:*",
    "@waveform-playlist/webaudio-peaks": "workspace:*",
    "@fortawesome/fontawesome-svg-core": "^6.5.1",
    "@fortawesome/free-solid-svg-icons": "^6.5.1",
    "@fortawesome/react-fontawesome": "^0.2.0",
    "react-async-hook": "^4.0.0",
    "waveform-data": "^4.4.0"
  }
}
