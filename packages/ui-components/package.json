{
  "name": "@waveform-playlist/ui-components",
  "version": "5.0.0-alpha.0",
  "description": "React UI components for waveform-playlist",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "keywords": [
    "waveform",
    "audio",
    "react",
    "components"
  ],
  "author": "Naomi Aro",
  "license": "MIT",
  "peerDependencies": {
    "@dnd-kit/core": "^6.0.0",
    "@dnd-kit/modifiers": "^6.0.0",
    "@dnd-kit/utilities": "^3.0.0",
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0",
    "styled-components": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "@dnd-kit/core": {
      "optional": true
    },
    "@dnd-kit/utilities": {
      "optional": true
    },
    "@dnd-kit/modifiers": {
      "optional": true
    }
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^6.0.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@storybook/addon-webpack5-compiler-swc": "^4.0.2",
    "@storybook/react-webpack5": "^10.0.8",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@types/styled-components": "^5.1.26",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "storybook": "^10.0.8",
    "styled-components": "^6.1.8",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "@storybook/addon-docs": "^10.0.8"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.5.1",
    "@fortawesome/free-solid-svg-icons": "^6.5.1",
    "@fortawesome/react-fontawesome": "^0.2.0",
    "@waveform-playlist/core": "workspace:*",
    "@waveform-playlist/loaders": "workspace:*",
    "@waveform-playlist/playout": "workspace:*",
    "@waveform-playlist/webaudio-peaks": "workspace:*",
