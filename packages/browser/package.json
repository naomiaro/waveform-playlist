{
  "name": "@waveform-playlist/browser",
  "version": "5.0.0-alpha.0",
  "description": "Browser bundle for waveform-playlist with React",
  "main": "./dist/waveform-playlist.js",
  "scripts": {
    "build": "pnpm typecheck && ./build-all.sh",
    "build:single": "pnpm typecheck && vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "waveform",
    "audio",
    "browser",
    "react"
  ],
  "author": "Naomi Aro",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.6",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^5.1.1",
    "typescript": "^5.3.3",
    "vite": "^7.2.4"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@waveform-playlist/annotations": "workspace:*",
    "@waveform-playlist/core": "workspace:*",
    "@waveform-playlist/loaders": "workspace:*",
    "@waveform-playlist/playout": "workspace:*",
    "@waveform-playlist/recording": "workspace:*",
    "@waveform-playlist/ui-components": "workspace:*",
    "@waveform-playlist/webaudio-peaks": "workspace:*",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "styled-components": "^6.1.8",
    "tone": "15.1.22",
    "waveform-data": "^4.4.0"
  }
