{
  "name": "@waveform-playlist/state",
  "version": "5.0.0-alpha.0",
  "description": "State management for waveform-playlist using Zustand",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["waveform", "audio", "state", "zustand"],
  "author": "Naomi Aro",
  "license": "MIT",
  "devDependencies": {
    "tsup": "^8.0.1",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@waveform-playlist/core": "workspace:*",
    "zustand": "^4.4.7",
    "immer": "^10.0.3"
  }
}
